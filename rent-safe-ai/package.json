{
  "name": "rent-safe-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prepare": "husky install",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "ops:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-postgres.ps1",
    "ops:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-postgres.ps1",
    "ops:retention": "powershell -ExecutionPolicy Bypass -File scripts/prune-retention.ps1"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  },
  "packageManager": "pnpm@9.0.0"
}
