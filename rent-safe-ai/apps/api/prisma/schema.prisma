generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// USERS & IDENTITY
// -----------------------------------------------------------------------------

model User {
  id                    String              @id @default(uuid())
  role                  Role                @default(TENANT)
  email                 String              @unique
  hashedPassword        String
  phone                 String?             @unique
  status                UserStatus          @default(ACTIVE)
  isEmailVerified       Boolean             @default(false)
  isPhoneVerified       Boolean             @default(false)
  locale                String              @default("en-IN")
  
  deviceFingerprints    Json?               @default("[]")
  flaggedForFraud       Boolean             @default(false)
  
  profile               UserProfile?
  ownerKycCases         OwnerKycCase[]
  bankAccounts          OwnerBankAccount[]
  properties            Property[]          @relation("PropertyOwner")
  contactRequests       ContactRequest[]
  viewingRequests       ViewingRequest[]
  fraudReports          FraudReport[]       @relation("FraudReporter")
  assignedFraudReports  FraudReport[]       @relation("FraudAssignee")
  paymentHolds          PaymentHold[]       @relation("PaymentHoldOwner")
  consents              Consent[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference?
  sessions              Session[]
  privacyRequests       PrivacyRequest[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?           // Soft delete

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Session {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  refreshTokenHash String
  familyId  String
  deviceId  String?
  status    SessionStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([familyId])
  @@map("sessions")
}

model OtpAttempt {
  id        String   @id @default(uuid())
  phone     String?
  email     String?
  codeHash  String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
  @@map("otp_attempts")
}

model UserProfile {
  id                    String              @id @default(uuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id])
  displayName           String?
  firstName             String?
  lastName              String?
  avatarUrl             String?
  ownerState            OwnerState          @default(PROFILE_PENDING)
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("user_profiles")
}

model OwnerKycCase {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id])
  provider              String
  providerReference     String              @unique
  status                VerificationStatus  @default(PENDING)
  maskedResult          Json?               // Store safe attributes like masked DOB, Name
  normalizedName        String?
  reviewerDecision      String?
  reviewedAt            DateTime?
  expiryDate            DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("owner_kyc_cases")
}

model OwnerBankAccount {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id])
  encryptedToken        String              // Envelope encrypted
  providerReference     String?
  maskedAccount         String              // e.g., ****1234
  beneficiaryResult     String?             // Name returned by verification
  status                VerificationStatus  @default(PENDING)
  isPrimary             Boolean             @default(false)
  reviewerDecision      String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("owner_bank_accounts")
}

// -----------------------------------------------------------------------------
// PROPERTIES & LISTINGS
// -----------------------------------------------------------------------------

model Property {
  id                    String              @id @default(uuid())
  ownerId               String
  owner                 User                @relation("PropertyOwner", fields: [ownerId], references: [id])
  propertyType          PropertyType
  
  structuredAddress     Json
  chennaiLocality       String
  latitude              Float?
  longitude             Float?
  normalizedAddressHash String              @unique // Partial unique constraint will be added in SQL
  status                PropertyStatus      @default(ACTIVE)

  identifiers           PropertyIdentifier[]
  documents             PropertyDocument[]
  verifications         PropertyVerification[]
  challenges            PresenceChallenge[]
  listings              Listing[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  @@map("properties")
}

model PropertyIdentifier {
  id                    String              @id @default(uuid())
  propertyId            String
  property              Property            @relation(fields: [propertyId], references: [id])
  identifierType        String              // e.g., 'SURVEY_NUMBER'
  encryptedValue        String              // Envelope encrypted
  normalizedHash        String              // For duplicate checking
  
  createdAt             DateTime            @default(now())

  @@map("property_identifiers")
}

model PropertyDocument {
  id                    String              @id @default(uuid())
  propertyId            String
  property              Property            @relation(fields: [propertyId], references: [id])
  documentType          DocumentType
  objectKey             String              // Private S3 key
  mimeType              String              @default("application/pdf")
  checksum              String
  quarantineStatus      QuarantineStatus    @default(PENDING_SCAN)
  extractedFields       Json?
  reviewState           ReviewState         @default(PENDING)
  expiryDate            DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("property_documents")
}

model PropertyVerification {
  id                    String              @id @default(uuid())
  propertyId            String
  property              Property            @relation(fields: [propertyId], references: [id])
  checkType             String              // e.g., 'PRESENCE_PROOF', 'OWNERSHIP'
  status                VerificationStatus  @default(PENDING)
  evidenceReference     String?
  reviewerId            String?             // Admin UUID
  completedAt           DateTime?
  expiryDate            DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("property_verifications")
}

model PresenceChallenge {
  id                    String              @id @default(uuid())
  propertyId            String
  property              Property            @relation(fields: [propertyId], references: [id])
  phrase                String
  status                VerificationStatus  @default(PENDING)
  expiresAt             DateTime
  submittedLat          Float?
  submittedLng          Float?
  mediaKey              String?

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("presence_challenges")
}

model Listing {
  id                    String              @id @default(uuid())
  propertyId            String
  property              Property            @relation(fields: [propertyId], references: [id])
  version               Int                 @default(1) // Optimistic concurrency
  
  rentAmount            Int                 // Stored in paise
  depositAmount         Int                 // Stored in paise
  furnishing            String
  bedroomCount          Int                 @default(1)
  amenities             Json                @default("[]")
  availability          DateTime
  description           String?
  mediaOrder            Json                @default("[]")
  lifecycleState        PublishStatus       @default(DRAFT)
  publishedVersion      Int?                // Links to ListingVersion
  
  media                 ListingMedia[]
  versions              ListingVersion[]
  contactRequests       ContactRequest[]
  viewingRequests       ViewingRequest[]
  agreements            Agreement[]
  paymentOrders         PaymentOrder[]
  paymentExceptions     PaymentEligibilityException[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  @@map("listings")
}

model ListingMedia {
  id                    String              @id @default(uuid())
  listingId             String
  listing               Listing             @relation(fields: [listingId], references: [id])
  privateOriginalKey    String
  publicDerivativeKey   String
  mimeType              String              @default("image/jpeg")
  sha256Hash            String
  pHash                 String
  quarantineStatus      QuarantineStatus    @default(PENDING_SCAN)
  challengeMetadata     Json?               // Unstripped EXIF/Timestamp
  reviewState           ReviewState         @default(PENDING)
  
  createdAt             DateTime            @default(now())

  @@map("listing_media")
}

model ListingVersion {
  id                    String              @id @default(uuid())
  listingId             String
  listing               Listing             @relation(fields: [listingId], references: [id])
  versionNumber         Int
  snapshotData          Json                // Immutable copy of critical data
  
  createdAt             DateTime            @default(now())

  @@map("listing_versions")
}

// -----------------------------------------------------------------------------
// TENANT INTERACTIONS
// -----------------------------------------------------------------------------

model ContactRequest {
  id                    String              @id @default(uuid())
  tenantId              String
  tenant                User                @relation(fields: [tenantId], references: [id])
  listingId             String
  listing               Listing             @relation(fields: [listingId], references: [id])
  
  status                ContactStatus       @default(PENDING)
  consentTimestamp      DateTime?
  disclosureTimestamp   DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("contact_requests")
}

model ViewingRequest {
  id                    String              @id @default(uuid())
  tenantId              String
  tenant                User                @relation(fields: [tenantId], references: [id])
  listingId             String
  listing               Listing             @relation(fields: [listingId], references: [id])
  
  schedule              DateTime
  status                ViewingStatus       @default(PROPOSED)
  tenantConfirmedAt     DateTime?
  ownerConfirmedAt      DateTime?
  disagreementState     String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("viewing_requests")
}

model Agreement {
  id                    String              @id @default(uuid())
  listingId             String
  listing               Listing             @relation(fields: [listingId], references: [id])
  tenantId              String
  ownerId               String
  documentKey           String
  status                AgreementStatus     @default(DRAFT)
  paymentOrders         PaymentOrder[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("agreements")
}

// -----------------------------------------------------------------------------
// PAYMENTS (SANDBOX)
// -----------------------------------------------------------------------------

model PaymentOrder {
  id                    String              @id @default(uuid())
  tenantId              String
  listingId             String
  listing               Listing             @relation(fields: [listingId], references: [id])
  agreementId           String
  agreement             Agreement           @relation(fields: [agreementId], references: [id])
  amount                Int                 // Stored in paise
  currency              String              @default("INR")
  status                PaymentStatus       @default(CREATED)
  idempotencyKey        String              @unique
  providerOrderId       String?             @unique
  eligibilitySnapshot   Json?
  
  transactions          PaymentTransaction[]
  webhookEvents         PaymentWebhookEvent[]
  refunds               Refund[]
  paymentHolds          PaymentHold[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("payment_orders")
}

model PaymentTransaction {
  id                    String              @id @default(uuid())
  orderId               String
  order                 PaymentOrder        @relation(fields: [orderId], references: [id])
  providerReference     String
  status                String
  eventType             String
  metadata              Json?
  
  createdAt             DateTime            @default(now())

  @@map("payment_transactions")
}

model PaymentWebhookEvent {
  id                    String              @id @default(uuid())
  orderId               String
  order                 PaymentOrder        @relation(fields: [orderId], references: [id])
  eventId               String              @unique // Idempotency
  eventType             String
  payload               Json
  
  createdAt             DateTime            @default(now())

  @@map("payment_webhook_events")
}

model Refund {
  id                    String              @id @default(uuid())
  orderId               String
  order                 PaymentOrder        @relation(fields: [orderId], references: [id])
  amount                Int                 // Stored in paise
  status                RefundStatus        @default(PENDING)
  providerReference     String?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("refunds")
}

// -----------------------------------------------------------------------------
// FRAUD, RISK & AUDIT
// -----------------------------------------------------------------------------

model FraudReport {
  id                    String              @id @default(uuid())
  reporterId            String
  reporter              User                @relation("FraudReporter", fields: [reporterId], references: [id])
  subjectType           String              // 'LISTING', 'USER', 'MESSAGE'
  subjectId             String
  category              String
  narrative             String
  evidence              Json?
  severity              SignalSeverity      @default(MEDIUM)
  status                ReportStatus        @default(OPEN)
  assignedToId          String?
  assignedTo            User?               @relation("FraudAssignee", fields: [assignedToId], references: [id])
  resolution            String?
  resolvedAt            DateTime?
  ownerNotifiedAt       DateTime?
  paymentHolds          PaymentHold[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("fraud_reports")
}

model PaymentEligibilityException {
  id          String   @id @default(uuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  tenantId    String
  approvedBy  String
  reason      String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([listingId, tenantId, expiresAt])
  @@map("payment_eligibility_exceptions")
}

model PaymentHold {
  id             String       @id @default(uuid())
  ownerId        String
  owner          User         @relation("PaymentHoldOwner", fields: [ownerId], references: [id])
  reportId       String
  report         FraudReport  @relation(fields: [reportId], references: [id])
  paymentOrderId String?
  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id])
  reason         String
  status         PaymentHoldStatus @default(PENDING_REVIEW)
  releasedAt     DateTime?
  releasedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([ownerId, status])
  @@index([reportId])
  @@map("payment_holds")
}

model RiskSignal {
  id                    String              @id @default(uuid())
  ruleCode              String
  severity              SignalSeverity
  entityType            String
  entityId              String
  evidenceJson          Json
  status                SignalStatus        @default(ACTIVE)
  reviewerResolution    String?
  
  createdAt             DateTime            @default(now())

  @@map("risk_signals")
}

model ReviewCase {
  id                    String              @id @default(uuid())
  targetType            String
  targetId              String
  status                ReviewState         @default(PENDING)
  
  actions               ReviewAction[]
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("review_cases")
}

model ReviewAction {
  id                    String              @id @default(uuid())
  caseId                String
  case                  ReviewCase          @relation(fields: [caseId], references: [id])
  reviewerId            String
  actionTaken           String
  notes                 String?
  
  createdAt             DateTime            @default(now())

  @@map("review_actions")
}

model Consent {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id])
  policyVersion         String
  purpose               String
  withdrawalTimestamp   DateTime?
  
  createdAt             DateTime            @default(now())

  @@map("consents")
}

model AuditLog {
  id                    String              @id @default(uuid())
  actorId               String
  action                String
  entityType            String
  entityId              String
  beforeHash            String?
  afterHash             String?
  requestId             String?
  ipDeviceReference     String?
  reason                String?
  
  createdAt             DateTime            @default(now()) // Append only

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model OutboxEvent {
  id                    String              @id @default(uuid())
  eventType             String
  payload               Json
  processedAt           DateTime?
  attempts              Int                 @default(0)
  nextAttemptAt         DateTime             @default(now())
  lastError             String?
  lockedAt              DateTime?
  deadLetteredAt        DateTime?
  
  createdAt             DateTime            @default(now())

  @@index([processedAt, nextAttemptAt])
  @@index([deadLetteredAt])
  @@map("outbox_events")
}

model Notification {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id])
  title                 String
  body                  String
  eventType             String?
  deduplicationKey      String?
  channel               NotificationChannel @default(IN_APP)
  deliveryStatus        NotificationDeliveryStatus @default(PENDING)
  deliveredAt           DateTime?
  lastError             String?
  isRead                Boolean             @default(false)
  
  createdAt             DateTime            @default(now())

  @@map("notifications")
  @@unique([userId, deduplicationKey])
}

model NotificationPreference {
  id                    String              @id @default(uuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id])
  emailEnabled          Boolean             @default(true)
  smsEnabled            Boolean             @default(true)
  pushEnabled           Boolean             @default(true)
  
  updatedAt             DateTime            @updatedAt

  @@map("notification_preferences")
}

model PrivacyRequest {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id])
  type                  PrivacyRequestType
  status                PrivacyRequestStatus @default(PENDING)
  processedAt           DateTime?
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@map("privacy_requests")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  TENANT
  OWNER
  REVIEWER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

enum PublishStatus {
  DRAFT
  OWNER_KYC_PENDING
  PROPERTY_EVIDENCE_PENDING
  UNDER_REVIEW
  VERIFIED
  PUBLISHED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
  EXPIRED
  RENTED
  ARCHIVED
}

enum VerificationStatus {
  PENDING
  NEEDS_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum ReviewState {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SUSPENDED
  EXPIRED
}

enum DocumentType {
  TITLE_EXTRACT
  PROPERTY_TAX
  OTHER_EVIDENCE
}

enum ContactStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ViewingStatus {
  PROPOSED
  ACCEPTED
  RESCHEDULED
  CANCELLED
  COMPLETED
  DISPUTED
}

enum AgreementStatus {
  DRAFT
  UPLOADED
  SIGNED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUND_PENDING
  REFUNDED
  DISPUTED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum PaymentHoldStatus {
  PENDING_REVIEW
  RELEASED
  CONVERTED_TO_BLOCK
}

enum SignalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SignalStatus {
  ACTIVE
  RESOLVED
}

enum PrivacyRequestType {
  EXPORT
  DELETION
}

enum OwnerState {
  PROFILE_PENDING
  KYC_PENDING
  KYC_REVIEW
  VERIFIED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum PrivacyRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum PropertyType {
  APARTMENT
  INDEPENDENT_HOUSE
  VILLA
  BUILDER_FLOOR
}

enum QuarantineStatus {
  PENDING_SCAN
  CLEARED
  INFECTED
}
