# PostgreSQL
POSTGRES_USER=rentsafe
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=rentsafe_db
DATABASE_URL=postgresql://rentsafe:local_dev_password@localhost:5432/rentsafe_db?schema=public

# pgAdmin (Do not commit real credentials in production)
PGADMIN_DEFAULT_EMAIL=admin@rentsafe.local
PGADMIN_DEFAULT_PASSWORD=admin

# Redis
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000

# Mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
