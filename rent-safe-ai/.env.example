# PostgreSQL
POSTGRES_USER=rentsafe
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=rentsafe_db
DATABASE_URL=postgresql://rentsafe:local_dev_password@localhost:5432/rentsafe_db?schema=public

# pgAdmin (local development only)
PGADMIN_DEFAULT_EMAIL=admin@rentsafe.local
PGADMIN_DEFAULT_PASSWORD=admin

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3-compatible storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=rentsafe-private
MINIO_REGION=us-east-1

# Mailpit
MAIL_HOST=localhost
MAIL_PORT=1025

# Operations / retention (days)
RETENTION_AUDIT_DAYS=2555
RETENTION_OUTBOX_DAYS=30
RETENTION_NOTIFICATION_DAYS=730
BACKUP_RETENTION_DAYS=30

# Application
ENABLE_SWAGGER=true
CORS_ORIGIN=http://localhost:3000

# Required application secrets in production
JWT_SECRET=replace-with-a-random-32-character-secret
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
KYC_WEBHOOK_SECRET=replace-with-a-random-kyc-secret
MALWARE_SCAN_SECRET=replace-with-a-random-malware-secret
